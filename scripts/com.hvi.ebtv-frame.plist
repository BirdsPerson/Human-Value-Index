<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- One pixelated frame of Electric Basement TV every 30 s for the city's TVs (scripts/ebtv_frame.py).
     Runs an installed copy, so whatever branch the main checkout is on cannot stop the TVs:
       mkdir -p ~/Library/Application\ Support/hvi && cp scripts/ebtv_frame.py ~/Library/Application\ Support/hvi/ &&
       cp scripts/com.hvi.ebtv-frame.plist ~/Library/LaunchAgents/ &&
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hvi.ebtv-frame.plist
     Health is the job's own log (~/Library/Logs/hvi-ebtv-frame.log), not the .out file.
     Never /usr/bin/python3: it is the Xcode shim and exits 69 under launchd. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hvi.ebtv-frame</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/birdsperson/Library/Application Support/hvi/ebtv_frame.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/birdsperson/.nvm/versions/node/v24.15.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/birdsperson</string>
  </dict>
  <key>StartInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Users/birdsperson/Library/Logs/hvi-ebtv-frame.out</string>
  <key>StandardErrorPath</key><string>/Users/birdsperson/Library/Logs/hvi-ebtv-frame.err</string>
</dict>
</plist>
